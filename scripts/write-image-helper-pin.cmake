if(NOT EXISTS "${INPUT}" OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "Built image helper and explicit output header required")
endif()
file(SHA256 "${INPUT}" HELPER_SHA256)
string(TOUPPER "${HELPER_SHA256}" HELPER_SHA256)
set(PIN_CONTENT "// Generated from the actual built helper; do not edit.\n#pragma once\n#define MCLA_IMAGE_HELPER_SHA256 \"${HELPER_SHA256}\"\n")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" PREVIOUS_CONTENT)
    if(PREVIOUS_CONTENT STREQUAL PIN_CONTENT)
        return()
    endif()
endif()
file(WRITE "${OUTPUT}" "${PIN_CONTENT}")
