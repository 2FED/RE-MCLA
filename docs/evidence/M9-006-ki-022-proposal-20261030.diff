+void SDLInputDriver::RearmStoppedWheelEffectsLocked(ControllerState& state, const char* reason) {
+  if (!state.haptic || !has_focus_.load() || !REXCVAR_GET(wheel_force_feedback)) {
+    return;
+  }
+  const auto controller_index = static_cast<size_t>(&state - controllers_.data());
+  if (active_controller_index_ != controller_index) {
+    return;
+  }
+  if ((SDL_GetHapticFeatures(state.haptic) & SDL_HAPTIC_STATUS) == 0) {
+    return;
+  }
+  for (size_t effect_slot = 0; effect_slot < state.force_feedback_effects.size(); ++effect_slot) {
+    auto& effect = state.force_feedback_effects[effect_slot];
+    // Only infinite effects (centering spring/damper, continuous engine or
+    // road periodic) are owned across frames; finite events must expire.
+    if (!effect.running || effect.effect_id < 0 || effect.duration_ms != UINT32_MAX) {
+      continue;
+    }
+    if (SDL_GetHapticEffectStatus(state.haptic, effect.effect_id)) {
+      continue;
+    }
+    if (!SDL_RunHapticEffect(state.haptic, effect.effect_id, effect.iterations)) {
+      REXLOG_ERROR("SDL wheel FFB {} rearm failed for slot {}: {}", reason, effect_slot + 1,
+                   SDL_GetError());
+      continue;
+    }
+    state.force_feedback_total_start_count++;
+    REXLOG_INFO("SDL_WHEEL_FFB_EFFECT v=2 action=rearm slot={} type={} reason={}",
+                effect_slot + 1, GetWheelEffectTypeName(effect.type), reason);
+  }
+}
