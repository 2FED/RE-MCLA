+// KI-035: F10 guest sampler. For 10 s after an F10 it reads every guest
+// thread's innermost guest function and last kernel import at ~500 Hz and logs
+// the top entries per thread. A freeze whose frames still advance shows which
+// guest code polls; compare with an F10 taken during normal driving.
+std::mutex guest_sampler_mutex;
+std::jthread guest_sampler_thread;
+
+void RunGuestSampler(std::stop_token stop, rex::system::KernelState *kernel) {
+  using rex::system::XThread;
+  auto threads = kernel->object_table()->GetObjectsByType<XThread>();
+  struct Hist {
+    std::string name;
+    uint32_t samples = 0;
+    std::unordered_map<uint32_t, uint32_t> functions;
+    std::unordered_map<const char *, uint32_t> imports;
+  };
+  std::vector<Hist> hists(threads.size());
+  for (size_t i = 0; i < threads.size(); ++i) {
+    hists[i].name = threads[i]->name();
+  }
+  const auto end = std::chrono::steady_clock::now() + std::chrono::seconds(10);
+  while (!stop.stop_requested() && std::chrono::steady_clock::now() < end) {
+    for (size_t i = 0; i < threads.size(); ++i) {
+      auto *state = threads[i]->is_guest_thread() ? threads[i]->thread_state()
+                                                  : nullptr;
+      const PPCContext *ctx = state ? state->context() : nullptr;
+      if (!ctx) continue;
+      // Racy diagnostic reads of aligned scalars written by the guest thread.
+      const uint32_t function =
+          *static_cast<const volatile uint32_t *>(&ctx->current_function);
+      const char *import = *static_cast<const char *const volatile *>(
+          &ctx->last_import);
+      ++hists[i].samples;
+      ++hists[i].functions[function];
+      ++hists[i].imports[import];
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(2));
+  }
+  for (const auto &hist : hists) {
+    if (!hist.samples) continue;
+    std::vector<std::pair<uint32_t, uint32_t>> top(hist.functions.begin(),
+                                                   hist.functions.end());
+    std::sort(top.begin(), top.end(),
+              [](const auto &a, const auto &b) { return a.second > b.second; });
+    std::string line;
+    for (size_t k = 0; k < top.size() && k < 12; ++k) {
+      char item[32];
+      std::snprintf(item, sizeof(item), " %08X:%u", top[k].first, top[k].second);
+      line += item;
+    }
+    std::string imports;
+    for (const auto &[name, count] : hist.imports) {
+      imports += ' ';
+      imports += name ? name : "none";
+      imports += ':' + std::to_string(count);
+    }
+    MCLA_APP_INFO("MCLA_GUEST_SAMPLE v=1 thread='{}' samples={} fn={} last_import={}",
+                  hist.name, hist.samples, line, imports);
+  }
+}
+
+void StartGuestSampler(rex::system::KernelState *kernel) {
+  if (!kernel) return;
+  std::lock_guard lock(guest_sampler_mutex);
+  if (guest_sampler_thread.joinable()) {
+    guest_sampler_thread.request_stop();
+    guest_sampler_thread.join();
+  }
+  guest_sampler_thread = std::jthread(
+      [kernel](std::stop_token stop) { RunGuestSampler(stop, kernel); });
+}
+
+void StopGuestSampler() {
+  std::lock_guard lock(guest_sampler_mutex);
+  if (guest_sampler_thread.joinable()) {
+    guest_sampler_thread.request_stop();
+    guest_sampler_thread.join();
+  }
+}
