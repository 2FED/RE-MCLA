+// KI-026 race-transition camera softlock: default-off diagnostics, F10 state
+// block and an opt-in watchdog. See docs/evidence/KI-026-race-back-camera-softlock.md.
+
+#include <cstdint>
+#include <string>
+
+namespace rex::memory {
+class Memory;
+}
