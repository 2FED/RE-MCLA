+ID3D12PipelineState* PipelineCache::AwaitPipeline(void* handle) {
+  auto* pipeline = reinterpret_cast<Pipeline*>(handle);
+  if (pipeline == nullptr) {
+    return nullptr;
+  }
+  if (!pipeline->creation_complete.load(std::memory_order_acquire) &&
+      !creation_threads_.empty()) {
+    // Takes this pipeline too if no worker has picked it up yet.
+    CreateQueuedPipelinesOnProcessorThread();
+    // A worker that already took it always sets creation_complete.
+    while (!pipeline->creation_complete.load(std::memory_order_acquire)) {
+      std::this_thread::yield();
+    }
+  }
+  return pipeline->state.load(std::memory_order_acquire);
+}
