+// KI-037: complete first Photo Mode capture (M9-006).
+// See docs/evidence/M9-006-ki-037-photo-analysis-20261029.md.
+//
+// The photo album object (mcUIPhotoAlbum) captures the frame into a 1280x720
+// LIN_A8R8G8B8 texture backed by a 0x385000-byte physical allocation and
+// JPEG-encodes it on the CPU a few frames later. The capture window is
+// bracketed by two guest functions called from sub_8263EAA8:
+//   sub_8263D120  freeze for capture: sets the capture-active byte 0x8290622E,
+//                 saves and changes renderer masks (renderer+424/+428) and
+//                 requests a world pause (unverified)
+//   sub_8263D1E0  unfreeze: restores them and clears 0x8290622E
+// With asynchronous pipeline creation the GPU plugin skips draws whose
+// pipelines are not ready; in the capture frames that bakes missing geometry
+// and stale EDRAM into the photo. While the window is open the plugin waits
+// for such pipelines instead (d3d12_async_pipeline_wait). The game is frozen
+// then, so the one-off creation hitch is not visible in gameplay.
+
+#include "mcla_init.h"
+#include "mcla_logging.h"
+
+#include <rex/cvar.h>
+
+#include <atomic>
+
+REXCVAR_DEFINE_BOOL(mcla_photo_pipeline_wait, true, "MCLA",
+    "Photo Mode: wait for GPU pipelines still being created during the "
+    "capture window instead of dropping their draws (KI-037)")
+    .lifecycle(rex::cvar::Lifecycle::kInitOnly);
+
+namespace {
+
+constexpr const char *kWaitCvar = "d3d12_async_pipeline_wait";
+std::atomic<bool> window_open{false};
+
+void SetWait(bool value) {
+  if (!rex::cvar::SetFlagByName(kWaitCvar, value ? "true" : "false")) {
+    MCLA_APP_ERROR("MCLA photo capture: could not set {}={}", kWaitCvar, value);
+  }
+}
+
+}  // namespace
+
+// Strong override of the generated weak capture-freeze function.
+REX_EXTERN(sub_8263D120) {
+  static const bool wanted = REXCVAR_GET(mcla_photo_pipeline_wait);
+  if (wanted && !window_open.exchange(true)) {
+    SetWait(true);
+    MCLA_APP_INFO("MCLA photo capture: window open, pipeline wait on");
+  }
+  __imp__sub_8263D120(ctx, base);
+}
+
+// Strong override of the generated weak capture-unfreeze function.
+REX_EXTERN(sub_8263D1E0) {
+  __imp__sub_8263D1E0(ctx, base);
+  if (window_open.exchange(false)) {
+    SetWait(false);
+    MCLA_APP_INFO("MCLA photo capture: window closed, pipeline wait off");
+  }
+}
