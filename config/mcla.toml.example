# MCLA-R host configuration example.
# Copy this file beside mcla.exe as mcla.toml. Values in mcla.toml are loaded
# after command-line and environment values, so the file wins on conflicts.
# F4 opens the ReXGlue settings overlay; settings changed there are persisted
# to mcla.toml. Options marked restart-required take effect on the next launch.

# Guest video mode and host window. An empty resolution uses the explicit
# video_mode_* and window_* values below. Examples: "720p", "1080p", "4k".
resolution = ""
video_mode_width = 1280
video_mode_height = 720
video_mode_refresh_rate = 60.0
window_width = 0
window_height = 0
fullscreen = true
monitor = 0

# Host audio. audio_device is either "default" or the exact SDL playback
# device name. Device and volume changes require a restart.
audio_device = "default"
audio_volume = 1.0
audio_mute = false

# Controller backend. Physical controller identity and assignment remain an
# operating-system / SDL concern and are intentionally not persisted here.
input_backend = "sdl"
mnk_mode = false

# Racing wheels. SDL-classified wheels are admitted without a model allowlist;
# the defaults match the physically verified Thrustmaster T300 PlayStation rim
# and two-pedal set. Use -1 to disable an absent axis or button. POV-hat D-pad
# input is automatic; the four button overrides default to disabled. Title
# force feedback uses the full requested overall strength, while infinite
# periodic engine/road texture defaults to 40 percent so it does not mask
# finite curb/collision transients. Infinite directional constant force
# defaults to zero because the title can leave it pulling toward one edge;
# finite collision constants still use the full overall gain. All gains are
# configurable from 0 through 100 percent. Nonzero finite curb/collision
# primary amplitudes have a 75-percent minimum within the current overall gain
# so weak title events remain perceptible without amplifying directional offsets.
# Wheel-driver effect and global-gain limits
# still apply, and force feedback may be disabled without wheel input.
wheel_steering_axis = 0
wheel_brake_axis = 1
wheel_accelerator_axis = 2
wheel_steering_inverted = false
wheel_brake_inverted = true
wheel_accelerator_inverted = true
wheel_force_feedback = true
wheel_force_feedback_gain = 100
wheel_force_feedback_continuous_periodic_gain = 40
wheel_force_feedback_continuous_constant_gain = 0
wheel_force_feedback_minimum_transient_strength = 75
wheel_button_left_shoulder = 0
wheel_button_right_shoulder = 1
wheel_button_y = 2
wheel_button_x = 3
wheel_button_b = 4
wheel_button_a = 5
wheel_button_back = 6
wheel_button_start = 7
wheel_button_left_thumb = 10
wheel_button_right_thumb = 11
wheel_button_guide = 12
wheel_button_dpad_up = -1
wheel_button_dpad_down = -1
wheel_button_dpad_left = -1
wheel_button_dpad_right = -1

# Local diagnostics. F10 creates an on-demand package for a live softlock;
# unhandled native crashes are captured automatically by a separate helper.
# Nothing is uploaded. Packages can contain a screenshot, log paths, memory
# fragments, and a private save snapshot, so share the folder path first and
# inspect files before publishing them. The crash dialog supports Ctrl+C to
# copy its text. Change the bind here if F10 conflicts with another overlay.
mcla_diagnostics_enabled = true
mcla_crash_reporter_dialog = true
bind_mcla_debug_snapshot = "F10"

# Logging. An empty log_file uses the runtime default next to the executable.
log_level = "info"
log_file = ""
log_verbose = false
log_noisy = false
log_flush_interval = 0
log_max_file_size_mb = 5
log_max_files = 20

# Data roots. Empty user/cache roots use the platform defaults. game_data_root
# must be supplied either here or by the launcher/command line for guest boot.
game_data_root = ""
user_data_root = ""
update_data_root = ""
cache_root = ""
metadata_root = ""
